# Firebase Configuration for JUDGE Educational Platform
# Replace with your actual Firebase Project keys from Firebase Console > Project Settings > General > Your Apps
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=judge-educational.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=judge-educational
VITE_FIREBASE_STORAGE_BUCKET=judge-educational.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=100000000000
VITE_FIREBASE_APP_ID=1:100000000000:web:abcdef123456
